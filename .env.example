# ==============================================================================
# Intelligent API Security Gateway - Environment Configuration
# ==============================================================================

# Gateway Reverse Proxy Configuration
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8000
GATEWAY_WORKERS=1
LOG_LEVEL=INFO

# Downstream Microservice (Mock Backend)
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8001
BACKEND_SERVICE_URL=http://127.0.0.1:8001

# Cryptographic Identity & JWT Engine
JWT_SECRET_KEY=super-secret-production-grade-encryption-key-32chars
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=60

# Redis State, Sliding Window & Token Blacklist
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
# Fallback to in-memory fake redis if real Redis server is not reachable
USE_FAKE_REDIS_FALLBACK=true

# PostgreSQL Forensic Incident Store
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=securathon_audit
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/securathon_audit

# Rate Limiting Configuration (Sliding Window)
RATE_LIMIT_REQUESTS_PER_WINDOW=100
RATE_LIMIT_WINDOW_SECONDS=60

# Telemetry & Machine Learning (Isolation Forest)
ANOMALY_SCORE_THRESHOLD=0.75
TARPIT_DELAY_SECONDS=2.0

