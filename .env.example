# ==============================================================================
# 🛡️ Securathon Intelligent API Security Gateway - Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION ROUTING: SOURCE & DESTINATION URLS
# ------------------------------------------------------------------------------
# SOURCE_URL: The URL & port where Securathon Gateway is hosted
SOURCE_URL=http://0.0.0.0:8000
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8000

# DESTINATION_URL: The downstream application that Securathon protects & proxies to.
# -> TO TEST OTHER APPLICATIONS, SIMPLY CHANGE THIS DESTINATION URL!
# Examples:
#   - Default Mock Microservice: http://127.0.0.1:8001
#   - Local Node.js / React / Next.js app: http://localhost:3000
#   - Local Python / Flask / Django app: http://localhost:5000
#   - External API: https://httpbin.org
DESTINATION_URL=http://127.0.0.1:8001
BACKEND_SERVICE_URL=http://127.0.0.1:8001

# Downstream Mock Backend local runner settings (when using mock_backend.main)
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8001

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION (Forensic Incidents & Audit Log Store)
# ------------------------------------------------------------------------------
# Choose: "sqlite" (instant, zero-config file) or "postgres"
DB_TYPE=sqlite

# Direct database connection URL:
# SQLite fallback (default out-of-the-box, no external setup needed):
DATABASE_URL=sqlite+aiosqlite:///./securathon_audit.db

# PostgreSQL (uncomment if you want to use PostgreSQL or Docker):
# DB_TYPE=postgres
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/securathon_audit
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=securathon_audit
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ------------------------------------------------------------------------------
# 3. AUTHENTICATION POLICY
# ------------------------------------------------------------------------------
# Set REQUIRE_AUTH=true to enforce strict JWT verification (signature, alg: none check).
# Set REQUIRE_AUTH=false when testing other third-party apps that don't have JWT tokens yet.
# (When false, unauthenticated requests are assigned an IP identity, rate-limited, and
#  fully evaluated by AI behavioral anomaly detection).
REQUIRE_AUTH=true

JWT_SECRET_KEY=super-secret-production-grade-encryption-key-32chars
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=60

# ------------------------------------------------------------------------------
# 4. REDIS STATE & RATE LIMITING
# ------------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
# Automatically fall back to high-performance in-memory fake redis if Redis is down
USE_FAKE_REDIS_FALLBACK=true

# Sliding window rate limiting quotas
RATE_LIMIT_REQUESTS_PER_WINDOW=100
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_CUSTOMER=100
RATE_LIMIT_MERCHANT=250
RATE_LIMIT_ADMIN=1000
RATE_LIMIT_UNAUTH_IP=30

# ------------------------------------------------------------------------------
# 5. BEHAVIORAL AI & LOGGING
# ------------------------------------------------------------------------------
ANOMALY_SCORE_THRESHOLD=0.75
TARPIT_DELAY_SECONDS=2.0
LOG_LEVEL=INFO
